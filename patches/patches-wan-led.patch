diff --git a/trunk/user/rc/firewall_ex.c b/trunk/user/rc/firewall_ex.c
index efd5c0f11..95e2c40a3 100644
--- a/trunk/user/rc/firewall_ex.c
+++ b/trunk/user/rc/firewall_ex.c
@@ -760,6 +760,37 @@ get_sshd_bfp_time(int bfp_mode)
 	return i_bfp_time;
 }
 
+static int
+include_wan_guard(FILE *fp, const char *wan_if, int is_ipv6)
+{
+	int awg_port = 0;
+	const char *chain = is_ipv6 ? "WAN_GUARD6" : "WAN_GUARD";
+
+	if (!wan_if || !*wan_if)
+		return 0;
+
+/* AWG3/WireGuard server: open its UDP port to WAN only while the VPN server
+ * is enabled (type WireGuard). Port follows the VPN Server page (vpns_wg_port). */
+	if (nvram_match("vpns_enable", "1") && nvram_get_int("vpns_type") == 3)
+		awg_port = nvram_safe_get_int("vpns_wg_port", 51820, 1, 65535);
+	fprintf(fp, ":%s - [0:0]\n", chain);
+	fprintf(fp, "-A INPUT -i %s -j %s\n", wan_if, chain);
+	fprintf(fp, "-A %s -m %s --state ESTABLISHED,RELATED -j ACCEPT\n", chain, CT_STATE);
+	if (is_ipv6)
+		fprintf(fp, "-A %s -p udp --sport 547 --dport 546 -j ACCEPT\n", chain);
+	else
+		fprintf(fp, "-A %s -p udp --sport 67 --dport 68 -j ACCEPT\n", chain);
+	if (awg_port > 0)
+		fprintf(fp, "-A %s -p udp --dport %d -j ACCEPT\n", chain, awg_port);
+	/* SSH/SFTP from WAN: the checkbox in the SSH menu opens the port
+	 * automatically (same NVRAM sshd_wopen as the firewall page). */
+	if (nvram_invmatch("sshd_enable", "0") && nvram_match("sshd_wopen", "1"))
+		fprintf(fp, "-A %s -p tcp --dport 22 -j %s\n", chain, IPT_CHAIN_NAME_BFP_LIMIT);
+	fprintf(fp, "-A %s -j DROP\n", chain);
+
+	return 1;
+}
+
 static int
 ipt_filter_rules(char *man_if, char *wan_if, char *lan_if, char *lan_ip,
                  char *logaccept, char *logdrop, int tcp_mss_need)
@@ -826,6 +855,7 @@ ipt_filter_rules(char *man_if, char *wan_if, char *lan_if, char *lan_ip,
 	fprintf(fp, ":%s %s [0:0]\n", "INPUT", (is_fw_enabled) ? "DROP" : "ACCEPT");
 	fprintf(fp, ":%s %s [0:0]\n", "FORWARD", (is_fw_enabled) ? "DROP" :  "ACCEPT");
 	fprintf(fp, ":%s %s [0:0]\n", "OUTPUT", "ACCEPT");
+	include_wan_guard(fp, wan_if, 0);
 	fprintf(fp, ":%s - [0:0]\n", MINIUPNPD_CHAIN_IP4_FORWARD);
 	fprintf(fp, ":%s - [0:0]\n", IPT_CHAIN_NAME_VPN_LIST);
 	fprintf(fp, ":%s - [0:0]\n", IPT_CHAIN_NAME_BFP_LIMIT);
@@ -1413,6 +1443,7 @@ ip6t_filter_rules(char *man_if, char *wan_if, char *lan_if,
