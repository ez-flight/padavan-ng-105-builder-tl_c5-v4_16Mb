diff --git a/trunk/user/rc/my_control_led.h b/trunk/user/rc/my_control_led.h
new file mode 100644
index 000000000..3ce94da5e
--- /dev/null
+++ b/trunk/user/rc/my_control_led.h
@@ -0,0 +1,25 @@
+#ifndef MY_CONTROL_LED_H
+#define MY_CONTROL_LED_H
+
+#include "gpio_pins.h"
+
+#define PIN_GREN 9
+#define PIN_ORANGE 10
+
+static inline void my_control_wan_led_set_GREN(void)
+{
+    cpu_gpio_set_pin(PIN_GREN, 1);
+    cpu_gpio_set_pin(PIN_ORANGE, 0);
+}
+static inline void my_control_wan_led_set_ORANGE(void)
+{
+    cpu_gpio_set_pin(PIN_GREN, 0);
+    cpu_gpio_set_pin(PIN_ORANGE, 1);
+}
+static inline void my_control_wan_led_set_OFF(void)
+{
+    cpu_gpio_set_pin(PIN_GREN, 0);
+    cpu_gpio_set_pin(PIN_ORANGE, 0);
+}
+
+#endif
